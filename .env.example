# LTA DataMall account key (Land Transport Authority, Singapore)
# Used server-side only. It powers live images plus live congestion, incidents,
# flood/faulty-light hazards, road works, parking availability, ERP rates,
# EV charging, expressway travel times and EMAS messages.
# School/silver zones, ERP gantry geometry and HDB gantry heights come from
# keyless data.gov.sg datasets and need no key.
DATAMALL_ACCOUNT_KEY=your_account_key_here

# GitHub Pages: public HTTPS origin of the separately hosted Next.js transit backend.
# Keep DATAMALL_ACCOUNT_KEY on that backend only. Leave this unset for local development.
# Example format: https://your-transit-backend.example (no /api suffix).
NEXT_PUBLIC_TRANSIT_API_BASE=
